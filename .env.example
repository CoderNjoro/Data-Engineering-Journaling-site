# Copy this file to .env.local for local development with `vercel dev`
# On Vercel, add these as Environment Variables in Project Settings → Environment Variables

# JSONBin.io — free cloud storage for journal data
# 1. Create account at https://jsonbin.io
# 2. Create a new bin with empty object: {}
# 3. Copy your Master Key and Bin ID below
JSONBIN_API_KEY=your_jsonbin_master_key_here
JSONBIN_ID=your_jsonbin_bin_id_here

# Admin login (Ctrl+Shift+A on the site)
# Change these after your first deploy — they are NOT stored in the repo
ADMIN_EMAIL=admin@dejournal.com
ADMIN_PASS=ChangeMe123!

# Optional — used by daily reminder cron job
ADMIN_NAME=Journal Owner
TARGET_EMAIL=your@email.com
EMAILJS_SERVICE_ID=
EMAILJS_NOTIFY_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
